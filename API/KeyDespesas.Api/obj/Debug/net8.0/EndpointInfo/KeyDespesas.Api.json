      "TituloSalvarDto": {
        "required": [
          "dataEmissao",
          "dataVencimento",
          "descricao",
          "status",
          "tipo"
        ],
        "type": "object",
        "properties": {
          "tipo": {
            "minLength": 1,
            "pattern": "^[PR]$",
            "type": "string"
          },
          "descricao": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "idCategoria": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "dataEmissao": {
            "type": "string",
            "format": "date-time"
          },
          "dataVencimento": {
            "type": "string",
            "format": "date-time"
          },
          "valor": {
            "type": "number",
            "format": "double"
          },
          "status": {
            "minLength": 1,
            "pattern": "^(ABERTO|PAGO|CANCELADO|VENCIDO)$",
            "type": "string"
          }
        },
        "additionalProperties": false
      },
